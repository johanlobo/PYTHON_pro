v=float(input("enter the value of the gift card:"))
if v>=5000 and v<=10000:
    z=100+(v-5000)*0.08
    print("tax to be paid:",z,"rs")
elif v>10000 and v<=20000:
    z=100+(v-5000)*0.08+200+(v-10000)*0.1
    print("tax to be paid:",z,"rs")
elif v>20000 and v<=50000:
    z=100+(v-5000)*0.08+200+(v-10000)*0.1+1000+(v-20000)*0.12
    print("tax to be paid:",z,"rs")
elif v<5000:
    print("no tax to be paid")
else:
    print("invalid input")

